{
  "name": "Data Science Env",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",  
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": []
    },
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",   
        "ms-python.pylance",  
        "ms-toolsai.jupyter-keymap",
        "github.copilot"
       
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16GB"
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "pip install --cache-dir=/tmp/.cache -r requirements.txt",  // Automatically install dependencies
  "postCreateCommand": "echo 'Data Science environment is ready!'"
}
