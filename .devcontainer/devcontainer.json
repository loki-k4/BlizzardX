{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest",
      "installTools": true,
      "toolsToInstall": "pylint,black,flake8,ipython,jupyterlab,numpy,pandas,matplotlib,seaborn,scipy,scikit-learn,tensorflow,torch,sqlalchemy",
      "optimize": false,
      "enableShared": false,
      "installPath": "/usr/local/python",
      "installJupyterlab": true,
      "configureJupyterlabAllowOrigin": "http://localhost",
      "httpProxy": "http://blizzard.x.com:8080"
    }
  }
}
