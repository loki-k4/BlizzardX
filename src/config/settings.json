// This file contains the configuration settings for the application.
// The settings are used to configure the CPU usage, data sources, and other application settings.
// The settings are loaded by the application at startup and are used to configure the application.
// The settings are stored in a JSON format and are loaded by the application using the JSON parser.
// The settings are used to configure the application and are used to set the CPU usage, data sources, and other application settings.
{
    "cpu_config": {
        "async_fetch": true,
        "cpu_usage_limit": 85,
        "max_concurrent_workers": 12,
        "max_concurrent_processes": 6,
        "cpu_check_interval": 2,
        "chunk_size": 100,
        "dynamic_worker_adjustment": true
    },
    
    "data_sources": {
        "inventory": "https://www.ncei.noaa.gov/pub/data/ghcn/daily/ghcnd-inventory.txt",
        "stations": "https://www.ncei.noaa.gov/pub/data/ghcn/daily/ghcnd-stations.txt",
        "countries": "https://www.ncei.noaa.gov/pub/data/ghcn/daily/ghcnd-countries.txt",
        "states": "https://www.ncei.noaa.gov/pub/data/ghcn/daily/ghcnd-states.txt",
        "state_raw": "https://raw.githubusercontent.com/georgique/world-geojson/develop/states/usa/new_hampshire.json"
    }
}
